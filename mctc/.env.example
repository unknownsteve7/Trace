# Copy to .env and fill in. .env is git-ignored.
DATABASE_URL=sqlite:///./mctc_feedback.db

# Admin / analytics / export endpoints (HTTP Basic auth)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# ngrok tunnel (start_with_tunnel.py)
NGROK_AUTH_TOKEN=your_ngrok_auth_token_here
NGROK_DOMAIN=your-static-domain.ngrok-free.dev
