role 'Depot Manager'
	modelPermission: read

	tablePermission Dim_Route =
			```
			-- Dynamic RLS: a depot manager sees only the routes mapped to their
			-- sign-in in dbo.UserRouteAccess (no mapping = no rows).
			[route_id] IN CALCULATETABLE(
			    VALUES(UserRouteAccess[route_id]),
			    UserRouteAccess[user_email] = USERPRINCIPALNAME()
			)
			```

	tablePermission UserRouteAccess = [user_email] = USERPRINCIPALNAME()

	annotation PBI_Id = 3c9f3b5894174c379a953de3bd714bc3

